# Copy to .env (backend/.env is git-ignored). Real keys live ONLY there - never here,
# never in source code, tests, README or logs.

# --- STAGE 1 ---
# DATA_DIR=./data
# MAX_UPLOAD_MB=50
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- STAGE 2.5: analyzer / optional LLM ---
# heuristic (default, no key needed) | hybrid | llm
# ANALYZER_MODE=heuristic
# Shared by the analyzer, slide enrichment, and spoken lecture scripts. Any OpenAI-compatible endpoint works.
# If LLM_API_KEY is empty, OPENAI_API_KEY from the environment is used as a fallback.
LLM_API_KEY=
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TIMEOUT_SECONDS=60

# --- STAGE 6A: slide content enrichment ---
# none (default: no LLM is called, every slide keeps its rule-based content)
# | mock (offline template writer, for demos and tests - not a real LLM)
# | openai (real OpenAI-compatible provider; needs LLM_API_KEY and a model)
ENRICHMENT_PROVIDER=none
# Model for the enrichment (falls back to LLM_MODEL)
ENRICHMENT_MODEL=
# Sampling temperature (0.0-0.2 recommended). Sent only when set.
# ENRICHMENT_TEMPERATURE=0.1
# Per request timeout in seconds
# ENRICHMENT_TIMEOUT_SECONDS=60
# Retries for transient errors (timeout / rate limit / connection), 0-5
# ENRICHMENT_MAX_RETRIES=2
# Slides per LLM call (1-20) and parallel calls (1-8)
# ENRICHMENT_BATCH_SIZE=5
# ENRICHMENT_MAX_CONCURRENCY=1
# Reuse answers for identical input (true|false)
# ENRICHMENT_CACHE_ENABLED=true

# --- STAGE 7/8: presentation provider ---
# mock     (default) offline MockPresentationProvider; its file is a placeholder deck, not a real design
# genspark the real Genspark CLI (`gsk`): needs the CLI installed and either `gsk login` (run once in a terminal)
#          or GENSPARK_API_KEY below. Without them the
#          API answers "not configured" (it never falls back to the mock). A real run consumes Genspark credits.
GENSPARK_MODE=mock

# Genspark CLI: install with `npm install -g @genspark/cli`, then EITHER run `gsk login` (leave the key empty; the CLI
# uses the credentials it saved itself) OR set the key here. The key goes ONLY into backend/.env, is handed to the
# CLI through its environment and is never printed or stored elsewhere.
GENSPARK_API_KEY=
# Optional: the CLI's --base-url (default https://www.genspark.ai)
# GENSPARK_API_URL=
# Optional: full path of the CLI if `gsk` is not on PATH
# GENSPARK_CLI_PATH=
# Seconds before a running Genspark job is stopped (60-7200)
# GENSPARK_TIMEOUT_SECONDS=2100

# --- lecture video (PPT + spoken script) ---
# Korean neural voice used by edge-tts. Leave empty for ko-KR-SunHiNeural.
# VIDEO_VOICE=ko-KR-SunHiNeural